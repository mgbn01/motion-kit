# Copie para .env (fica fora do Git) e preencha só o que for usar.

# Pasta onde o `npm run entregar` copia os vídeos prontos. Absoluta, relativa à raiz ou começando com ~/.
# Vazia: entregas/ na raiz do repositório.
PASTA_ENTREGA=

# Chave da ElevenLabs (voz, música e efeitos da V3). Gastar crédito pede OK antes.
ELEVENLABS_API_KEY=

# Regras de cada marca: troque EXEMPLO pelo id da marca em maiúsculas (hífen vira _). Termos separados por ;
# Termos que nunca aparecem nos reels da marca.
EXEMPLO_PROIBIDOS=
# Termos proibidos que o anúncio de venda (tipo: venda) pode e deve mostrar, como o registro profissional exigido pelo conselho.
EXEMPLO_PERMITIDOS_VENDA=
